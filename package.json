{
  "name": "anvesh-ai-malware-detector",
  "version": "1.0.0",
  "description": "ANVESH: Static malicious-file analysis and threat-risk assessment system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build --config client/vite.config.js",
    "build": "npm run build:client",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test": "cross-env NODE_ENV=test node --test tests/**/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
