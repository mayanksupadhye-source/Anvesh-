# ANVESH AI Malware Detector - Environment Configuration Template
# Copy this file to .env and configure your local settings.

# Server Port
PORT=5000

# Application Environment (development | production)
NODE_ENV=development

# Maximum Upload File Size Limit in Megabytes
MAX_FILE_SIZE_MB=30

# ClamAV Antivirus Daemon (clamd) Configuration
# If ClamAV is running as a daemon on localhost or a remote server:
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# ClamAV CLI Binary Fallback (if daemon is not used)
# Path to clamscan executable in system PATH or full absolute path
CLAMSCAN_PATH=clamscan

# Optional: VirusTotal Public Threat Intelligence API Key (v3)
# If omitted or left empty, ANVESH honestly marks VirusTotal reputation as 'Not Configured'
# Get a free API key at: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=
